# Binance API Configuration
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Telegram Notification (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Database Configuration
DATABASE_URL=sqlite:///data/trading.db

# Trading Configuration
TRADING_MODE=sandbox  # sandbox or live
INITIAL_BALANCE=10000  # Initial account balance in USDT
TIMEFRAME=1h  # 1h, 4h, 1d

# Strategy Parameters
FAST_SMA_PERIOD=10
SLOW_SMA_PERIOD=30
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# Risk Management
STOP_LOSS_PERCENT=2.0  # Stop loss at -2%
BASE_TAKE_PROFIT=5.0  # Base take profit 5%
POSITION_SIZE_PERCENT=10.0  # Position size 10% of account
MAX_DRAWDOWN_PERCENT=15.0  # Maximum drawdown limit
DAILY_LOSS_LIMIT=10.0  # Daily loss limit 10%
CONSECUTIVE_LOSS_LIMIT=3  # Stop trading after 3 consecutive losses
COOLDOWN_HOURS=24  # Cooldown period in hours

# Data Configuration
KLINES_HISTORY_LENGTH=500  # Historical klines to fetch
CURVATURE_WINDOW=20  # Window for curvature calculation